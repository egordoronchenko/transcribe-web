# Скопируй в .env и заполни. .env не коммитить (уже в .gitignore).

# Корень доступа: всё, что внутри, видно в веб-интерфейсе как /host/root.
# Можно указать целый диск (F:/) или одну папку. Прямые слэши надёжнее на Windows.
HOST_ROOT=F:/

# Ключ OpenRouter (обязателен). Никогда не публикуется и не показывается на странице.
OPENROUTER_API_KEY=

OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Модель Whisper. По умолчанию максимальное качество.
WHISPER_MODEL=openai/whisper-large-v3

# Язык: код Whisper (ru, en, de, es, ...) или auto — автоопределение.
LANGUAGE=ru

# Файл-подсказка (initial prompt) с доменными терминами. Путь внутри контейнера.
PROMPT_FILE=/app/prompts/whisper_initial_prompt.txt

# Порт веб-интерфейса на хосте.
PORT=8080
