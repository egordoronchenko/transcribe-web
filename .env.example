# Скопируй в .env и заполни. .env не коммитить (уже в .gitignore).

# Корень доступа: всё, что внутри, видно в веб-интерфейсе как /host/root.
# Можно указать целый диск (F:/) или одну папку. Прямые слэши надёжнее на Windows.
HOST_ROOT=F:/

# API-ключ провайдера (обязателен). Никогда не публикуется и не показывается на странице.
OPENROUTER_API_KEY=

# Любой OpenAI-совместимый провайдер транскрибации. Примеры:
#   OpenRouter (default): https://openrouter.ai/api/v1   модель openai/whisper-large-v3
#   RouterAI:             https://routerai.ru/api/v1     модель openai/whisper-large-v3
#   Groq напрямую:        https://api.groq.com/openai/v1 модель whisper-large-v3
#   OpenAI:               https://api.openai.com/v1      модель whisper-1
#   Локальный сервер (speaches/faster-whisper-server): http://host.docker.internal:8000/v1
# Требование: модель должна поддерживать response_format=verbose_json (таймкоды сегментов).
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Модель Whisper — имя в терминах выбранного провайдера.
WHISPER_MODEL=openai/whisper-large-v3

# Язык: код Whisper (ru, en, de, es, ...) или auto — автоопределение.
LANGUAGE=ru

# Файл-подсказка (initial prompt) с доменными терминами. Путь внутри контейнера.
PROMPT_FILE=/app/prompts/whisper_initial_prompt.txt

# Порт веб-интерфейса на хосте.
PORT=8080
